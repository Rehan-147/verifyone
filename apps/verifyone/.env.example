# ── VerifyOne environment ──────────────────────────────────────
# Copy to .env and fill. Every key is OPTIONAL at first — without keys the
# product runs on deterministic mocks; with keys it's fully live.

# APP_URL (self-reference used by webhooks/MCP docs)
APP_URL=http://localhost:3000

# ── BULK LIST AUDITS ──
# Maximum submitted rows in one job; oversized uploads return HTTP 413.
BULK_MAX_ROWS=10000
# Bulk jobs and their row-level evidence references expire after this many days.
BULK_RETENTION_DAYS=30

# ── PHONE (carrier, line type, disconnected) ──
# https://portal.telnyx.com — signup gives free trial credit. ~$0.0015-0.005/lookup
TELNYX_API_KEY=

# ── EMAIL (pick ONE, Reoon is cheapest) ──
# https://www.reoon.com/email-verifier/ — $11.90 for 10,000 verifications
REOON_API_KEY=
# Alternative: https://www.zerobounce.net — pricier, bigger brand name
ZEROBOUNCE_API_KEY=

# ── IP ──
# https://ipinfo.io/signup — free 50,000/mo
IPINFO_TOKEN=

# ── COMPLIANCE (Phase 2) ──
# FTC DNC registry: free download at https://telemarketing.donotcall.gov (needs free SAN)
#   -> save the full-file download as .data/dnc-us.txt (one number per line)
# Litigator trap numbers (TCPA plaintiff scrubs) — one 10-digit line each:
#   -> .data/litigators.txt (refresh weekly from DNC.com or your scrub vendor)
# Litigator scrub vendors (e.g. https://www.dnc.com, quote-based) deliver a FILE, not an
# API key: export the scrub to .data/litigators.txt or host it at LITIGATOR_REGISTRY_URL.
# There is intentionally no DNC_COM_API_KEY — no code reads one.

# ── REASSIGNED NUMBER (FCC RNDB) — pick ONE path ──
# 1) Generic provider (e.g. reassigned.us — ~$8/1,000 queries Tier 1):
#      RNDB_API_KEY + RNDB_API_URL (GET {RNDB_API_URL}?phone={e164} with Bearer key,
#      expects { "reassigned": bool, "last_reassigned_date"?: "YYYY-MM-DD" })
# 2) Twilio Lookup v2 (needs the reassigned_number field enabled for the SID):
#      TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN
# Without either, full_stack profile returns decision REVIEW (reassigned_check_unavailable) —
# the gate never silently assumes a number was NOT reassigned. Metering: full_stack = 5
# credits/check (includes the RNDB query); TrustedForm verification = +1 credit.
RNDB_API_KEY=
RNDB_API_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── EVIDENCE EXPORT SIGNING ──
# HMAC-SHA256 key over single-evidence exports (/api/v1/gate/audit/{id}/export) —
# the hand-to-client/auditor artifact. Recipients verify the export offline with
# the openssl instructions embedded in it. Set a strong random value in production.
EVIDENCE_EXPORT_SECRET=

# ── PLATFORM CREDENTIAL ENCRYPTION (customer Vapi / Retell keys) ──
# Generate a 32-byte base64 key: openssl rand -base64 32
VERIFYONE_CREDENTIALS_KEY=

# ── AREA-CODE-SCOPED DNC INGEST (scale path) ──
# Point DNC_REGISTRY_URL at a URL containing the literal '{areacode}' (per-NPA bundles,
# e.g. presigned S3/R2 auto-refreshed copies of the FTC area files) and set the NPA list:
DNC_AREA_CODES=

# ── CANADA DNCL (CRTC) — optional second NANP registry ──
# Canadian numbers share the +1 numbering plan, so the gate answers both the FTC
# (US) and CRTC (Canada) lists with one lookup. Point DNC_CA_REGISTRY_URL at the
# registrant download of the CRTC National DNCL (paid registrant access; save the
# extract as .data/dnc-ca.txt for localhost). Supports the same '{areacode}'
# template as the US path; defaults to major Canadian NPAs, override with:
DNC_CA_REGISTRY_URL=
DNC_CA_AREA_CODES=

# ── CONSENT CERTIFICATION (TrustedForm / ActiveProspect) ──
# Verifies the consent certificate attached to a lead (trustedform_cert_url).
# Without a key the gate returns REVIEW (consent_cert_unverified) when a cert
# URL is supplied on the full_stack profile — fail-closed, not silent-allow.
TRUSTEDFORM_API_KEY=
# Optional override; default https://api.trustedform.com
TRUSTEDFORM_API_URL=

# ── PAYMENTS (Dodo Payments — merchant of record) ──
# 1. Sign up: https://app.dodopayments.com  (test mode is free)
# 2. Create 3 monthly products — names/prices/credits come from lib/plans.ts (single source):
#      STARTER -> "Starter"  $299/mo  (30,000  gate checks)
#      GROWTH  -> "Growth"   $899/mo  (120,000 gate checks)
#      PRO     -> "Pro"      $2,399/mo (400,000 gate checks + MCP AI-agent endpoint)
#    See docs/billing/DODO_PAYMENTS.md. Keep the Dodo products in sync with lib/plans.ts
#    BEFORE enabling live checkout (DEPLOY.md §6b) — the Dodo product charges the amount.
# 3. Paste their prod_... ids below, plus your API key + webhook key
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_GROWTH=
DODO_PRODUCT_PRO=

# ── ROI DIGEST CRON ──
# Protect POST /api/cron/digest with this secret; send it as x-cron-secret header.
CRON_SECRET=
# Optional: Slack/Discord/Make webhook that receives the weekly digest text.
DIGEST_WEBHOOK_URL=

# ── DATABASE (production swap for the .data files) ──
# npx prisma db push
DATABASE_URL=postgresql://verifyone:verifyone@localhost:5433/verifyone?schema=public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production: require .data/dnc-us.txt + .data/litigators.txt (default on in production)
COMPLIANCE_REQUIRE_REGISTRIES=
COMPLIANCE_ALLOW_DEV_MOCKS=false
RNDB_API_KEY=

# Registry ingest (HTTPS presigned S3/R2 URLs — cron POST /api/cron/sync-registries)
DNC_REGISTRY_URL=
LITIGATOR_REGISTRY_URL=

# ── INTEGRATIONS ──
# HubSpot app token (Bearer) used by POST /api/webhooks/hubspot to GET a contact's phone and
# PATCH the verdict back — lib/integrations/hubspot.ts
# Requires a WORKING gate: hubspot.ts calls runPhoneGate in-process (same ladder as
# POST /api/v1/gate/phone), so load .data/dnc-us.txt + .data/litigators.txt first or set
# COMPLIANCE_ALLOW_DEV_MOCKS. With fail_closed and no registries, every contact is DENIED.
# APP_URL is NOT used by this path any more (the old /api/v1/validate self-call is gone);
# it is still needed for webhooks, sitemap and MCP docs.
# HubSpot custom properties written: verifyone_status, verifyone_reason, verifyone_evidence_id
HUBSPOT_TOKEN=

# The app's Client secret (HubSpot > Settings > Integrations > Apps > {app} > Auth). REQUIRED for
# POST /api/webhooks/hubspot — it verifies x-hubspot-signature-v3, a base64 HMAC-SHA256 over
# METHOD + REQUEST_URI + RAW_BODY + x-hubspot-request-timestamp with a 5-minute replay window.
# Unset, every delivery is rejected with 401 hubspot_app_secret_not_configured.
HUBSPOT_APP_SECRET=

# Optional: name of a HubSpot contact property carrying the consent token the gate needs
# (value: express_written or ebr). Left unset the webhook reports consent {declared:false,
# type:'none'} and the gate denies AI-voice dialing for every contact — that is fail-closed
# behaviour, not a misconfiguration. Create the property in HubSpot before pointing this at it.
HUBSPOT_CONSENT_PROPERTY=

