generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String?
  credits          Int            @default(1000)
  plan             String         @default("STARTER")
  stripeCustomerId String?
  apiKeys          ApiKey[]
  checks           CheckHistory[]
  createdAt        DateTime       @default(now())
}

model ApiKey {
  id        String    @id @default(cuid())
  key       String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  lastUsedAt DateTime?
}

model CheckHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  input       String
  result      Json
  creditsUsed Int
  createdAt   DateTime @default(now())
}

model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}
