generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id           String         @id @default(cuid())
  clerkOrgId   String         @unique
  name         String
  plan         String         @default("FREE")
  credits      Int            @default(1000)
  billingEmail String?
  disabledAt   DateTime?
  apiKeys      ApiKey[]
  creditLedger CreditLedger[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  name             String?
  credits          Int            @default(1000)
  plan             String         @default("FREE")
  dodoCustomerId   String?
  stripeCustomerId String?
  apiKeys          ApiKey[]
  checks           CheckHistory[]
  createdAt        DateTime       @default(now())
}

model ApiKey {
  id                   String        @id @default(cuid())
  keyHash              String        @unique
  name                 String        @default("Default key")
  prefix               String        @default("vk_live_")
  last4                String        @default("")
  orgId                String?
  org                  Organization? @relation(fields: [orgId], references: [id])
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id])
  createdByClerkUserId String?
  createdAt            DateTime      @default(now())
  lastUsedAt           DateTime?
  revokedAt            DateTime?

  @@index([orgId])
}

model CheckHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String
  input       String
  result      Json
  creditsUsed Int
  createdAt   DateTime @default(now())
}

model CreditLedger {
  id        String        @id @default(cuid())
  userId    String?
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime      @default(now())

  @@index([orgId])
}

// Pre-Dial Gate audit trail — the tamper-evident log agencies show their lawyers.
// Localhost MVP persists JSONL (.data/audit.jsonl); prod uses this table.
model GateAudit {
  id            String   @id @default(cuid())
  evidenceId    String   @unique
  seq           BigInt   @unique
  callerKeyHash String
  phoneMasked   String
  phoneHash     String
  channel       String
  decision      String
  reason        String
  checks        Json
  consent       Json?
  prevHash      String
  recordHash    String
  recordJson    String
  createdAt     DateTime @default(now())

  @@index([phoneHash, createdAt])
  @@index([decision, createdAt])
}

model ChainTail {
  id         Int      @id @default(1)
  recordHash String
  seq        BigInt
  updatedAt  DateTime @updatedAt
}

model PlatformCredential {
  id           String    @id @default(cuid())
  ownerKey     String
  platform     String
  encryptedKey String
  keyLast4     String
  defaults     Json
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([ownerKey, platform])
}

model DialIdempotency {
  id             String   @id @default(cuid())
  ownerKey       String
  idempotencyKey String
  requestHash    String
  state          String   @default("in_progress")
  responseStatus Int?
  response       Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime

  @@unique([ownerKey, idempotencyKey])
  @@index([expiresAt])
}

model BulkJob {
  id                 String    @id
  ownerKey           String
  status             String
  profile            String
  totalRows          Int
  uniqueRows         Int
  processedRows      Int       @default(0)
  invalidRows        Int       @default(0)
  duplicateRows      Int       @default(0)
  creditsCharged     Int       @default(0)
  columns            Json
  dataSourceSnapshot Json?
  simulatedData      Boolean   @default(false)
  leaseUntil         DateTime?
  leaseToken         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  expiresAt          DateTime
  rows               BulkRow[]

  @@index([ownerKey, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model BulkRow {
  id         String  @id @default(cuid())
  jobId      String
  rowIndex   Int
  original   Json
  phone      String?
  status     String
  decision   String?
  reason     String?
  riskScore  Int?
  evidenceId String?
  job        BulkJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@unique([jobId, rowIndex])
}

model ReviewItem {
  id                    String    @id @default(cuid())
  ownerKey              String
  kind                  String    // 'review' | 'dispute'
  gateEvidenceId        String
  phoneHash             String
  phoneMasked           String
  phoneEncrypted        String?
  reason                String    // internal reason
  publicReason          String
  status                String    @default("open") // 'open'|'approved'|'rejected'|'expired'
  createdAt             DateTime  @default(now())
  expiresAt             DateTime
  resolvedAt            DateTime?
  resolvedBy            String?
  note                  String?
  resolutionEvidenceId  String?
  approvalExpiresAt     DateTime?
  approvalUsedAt        DateTime?
  approvalUsedEvidenceId String?

  @@index([ownerKey, status, createdAt])
  @@index([ownerKey, phoneHash])
}

model SuppressionEntry {
  id               String    @id @default(cuid())
  ownerKey         String
  phoneHash        String
  phoneMasked      String
  phoneEncrypted   String?
  reason           String
  source           String
  requestedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  createdBy        String?
  sourceEvidenceId String?
  addEvidenceId    String?
  removedAt        DateTime?
  removedBy        String?
  removeReason     String?
  removeEvidenceId String?

  @@index([ownerKey, phoneHash])
}
