{
  "name": "verifyone-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=verifyone",
    "build": "npm run build --workspace=verifyone",
    "start": "npm run start --workspace=verifyone",
    "lint": "npm run lint --workspace=verifyone",
    "db:push": "npm run db:push --workspace=verifyone",
    "typecheck": "npm exec --workspace=verifyone -- tsc --noEmit",
    "test:ci": "node apps/verifyone/scripts/ci-run-tests.mjs"
  }
}
